# Clipping Studio - viral clip pipeline configuration
# Copy this file to .env and fill in only the providers you want to use.
# Never commit the real .env file.

# ---------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------
# Defaults are relative to the project root (or the EXE folder when frozen).
# VIRAL_OUTPUT_DIR=Clipping/output/viral
# VIRAL_TEMP_DIR=Clipping/tmp
# VIRAL_CACHE_DIR=

# ---------------------------------------------------------------------
# External tools
# ---------------------------------------------------------------------
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# ---------------------------------------------------------------------
# Download limits
# ---------------------------------------------------------------------
DOWNLOAD_FORMAT=bv*+ba/b
DOWNLOAD_TIMEOUT_SECONDS=1800
MAX_VIDEO_DURATION_SECONDS=14400
MAX_FILE_SIZE_MB=4096
MIN_FREE_SPACE_MB=500
MAX_RETRIES=3
MAX_CLIPS=10
MIN_CLIP_DURATION=20
MAX_CLIP_DURATION=90
JOB_WORKERS=1

# ---------------------------------------------------------------------
# LLM analysis (OpenAI-compatible chat completions)
# ---------------------------------------------------------------------
# auto = use the LLM when LLM_API_KEY is set, otherwise use the offline
# heuristic analyzer. openai / openai_compatible requires a key.
# gemini / google / google_gemini uses Google's OpenAI-compatible endpoint.
# heuristic forces the offline analyzer.
LLM_PROVIDER=auto
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_JSON_MODE=true
LLM_MAX_TRANSCRIPT_CHARS=60000
LLM_MAX_CHUNKS=12
# Optional path to a custom analysis prompt (separate from this file).
LLM_PROMPT_FILE=

# ---------------------------------------------------------------------
# Transcription
# ---------------------------------------------------------------------
# auto = native captions, then OpenAI-compatible Whisper if a key is set,
# then local faster-whisper if installed. Other values: captions, openai,
# local, none.
TRANSCRIPTION_PROVIDER=auto
TRANSCRIPTION_MODEL=whisper-1
# Leave empty to reuse LLM_API_KEY / LLM_BASE_URL (OpenAI-compatible Whisper).
# With LLM_PROVIDER=gemini, set these explicitly: Gemini does not serve Whisper.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_LANGUAGE=auto
STT_CHUNK_SECONDS=600
KEEP_AUDIO=false
LOCAL_WHISPER_MODEL=small

# ---------------------------------------------------------------------
# Clip extraction
# ---------------------------------------------------------------------
# auto = stream copy when valid, re-encode only when necessary.
CLIP_COPY_MODE=auto
CLIP_CRF=18
CLIP_PRESET=veryfast

# ---------------------------------------------------------------------
# Timing validation
# ---------------------------------------------------------------------
SNAP_TOLERANCE_SECONDS=2.0
MAX_OVERLAP_SECONDS=1.5
MAX_CLIP_OVERLAP_RATIO=0.15

# ---------------------------------------------------------------------
# Optional local API / web UI
# ---------------------------------------------------------------------
# Keep the host on 127.0.0.1 unless you add your own network protection.
VIRAL_API_HOST=127.0.0.1
VIRAL_API_PORT=8765
# Empty means no authentication. Set a long random value if the API is
# reachable by anyone other than you.
VIRAL_API_TOKEN=

LOG_LEVEL=INFO
